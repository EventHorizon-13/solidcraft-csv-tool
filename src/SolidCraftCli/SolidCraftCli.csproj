    <AssemblyName>standard-roller-seal</AssemblyName>
    <RootNamespace>SolidCraftCsvTool</RootNamespace>
    <Version>1.2</Version>
    <Product>标准辊密封批量生成 CLI</Product>
    <DebugType>embedded</DebugType>
