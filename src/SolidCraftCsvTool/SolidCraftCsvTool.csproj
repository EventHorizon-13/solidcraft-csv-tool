<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Assets/AppIcon.ico</ApplicationIcon>
    <AssemblyName>标准辊密封批量生成</AssemblyName>
    <RootNamespace>SolidCraftCsvTool</RootNamespace>
    <Version>1.1.3</Version>
    <Product>标准辊密封批量生成</Product>
    <BuildDate Condition="'$(BuildDate)' == ''">$([System.DateTime]::UtcNow.ToString('yyyy-MM-dd HH:mm:ss'))</BuildDate>
    <Description>Windows CSV/STEP batch tool for SolidCraft and dimensioned DXF machining drawings</Description>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets/AppIcon.ico" LogicalName="SolidCraftCsvTool.AppIcon.ico" />
    <EmbeddedResource Include="Assets/AppIcon.png" LogicalName="SolidCraftCsvTool.AppIcon.png" />
    <PackageReference Include="netDxf" Version="2023.11.10" />
    <AssemblyMetadata Include="BuildDate" Value="$(BuildDate)" />
  </ItemGroup>
</Project>
