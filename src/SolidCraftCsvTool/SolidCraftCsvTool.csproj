<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>Assets/AppIcon.ico</ApplicationIcon>
    <AssemblyName>标准辊密封批量生成</AssemblyName>
    <RootNamespace>SolidCraftCsvTool</RootNamespace>
    <Version>2.2.1</Version>
    <Product>标准辊密封批量生成</Product>
    <BuildDate Condition="'$(BuildDate)' == ''">$([System.DateTime]::UtcNow.ToString('yyyy-MM-dd HH:mm:ss'))</BuildDate>
    <Description>Windows CSV/STEP batch tool for SolidCraft and dimensioned DXF machining drawings</Description>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/AppIcon.png" />
    <Content Include="../../模板/标准辊密封.solidcraft" Link="模板/标准辊密封.solidcraft" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <PackageReference Include="netDxf" Version="2023.11.10" />
    <AssemblyMetadata Include="BuildDate" Value="$(BuildDate)" />
  </ItemGroup>
</Project>
